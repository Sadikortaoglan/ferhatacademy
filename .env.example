# ============================================================
# Ferhat Academy — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ferhatacademy?schema=public"
# For Prisma migrations with a direct (non-pooled) connection (e.g. Supabase):
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/ferhatacademy?schema=public"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-random-64-char-string"
BETTER_AUTH_URL="https://ferhatacademy.com"

# App URL (used in emails, redirects)
NEXT_PUBLIC_APP_URL="https://ferhatacademy.com"

# Node environment
NODE_ENV="production"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Ferhat Academy <noreply@ferhatacademy.com>"
ADMIN_NOTIFY_EMAIL="info@ferhatacademy.com"

# Dev-only seed credentials (never use in production)
# SEED_SUPER_ADMIN_EMAIL="superadmin@ferhatacademy.com"
# SEED_SUPER_ADMIN_PASSWORD="..."
# SEED_ADMIN_EMAIL="admin@ferhatacademy.com"
# SEED_ADMIN_PASSWORD="..."
# SEED_USER_EMAIL="user@ferhatacademy.com"
# SEED_USER_PASSWORD="..."
